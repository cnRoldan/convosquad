# Variables públicas: se incluyen en el bundle. Nunca uses claves secretas aquí.
# Déjalas vacías para trabajar con los datos simulados.
EXPO_PUBLIC_SUPABASE_URL=
# Clave moderna con prefijo sb_publishable_; no JWT anon heredado.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: URL real autorizada en Supabase para la confirmación PKCE.
# Linking usa el callback del cliente: esquema propio, Expo Go o web.
EXPO_PUBLIC_AUTH_REDIRECT_URL=

# Opcional: origen HTTPS desplegado para compartir invitaciones por WhatsApp.
# Sin rutas ni credenciales; por ejemplo el dominio de tu versión web.
EXPO_PUBLIC_INVITE_BASE_URL=
