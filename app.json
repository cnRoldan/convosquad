{
  "expo": {
    "name": "ConvoSquad",
    "slug": "convosquad",
    "version": "0.1.0",
    "scheme": "convosquad",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.convosquad.app"
    },
    "android": {
      "package": "com.convosquad.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "call-ups",
          "color": "#B4F16C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "99946f80-dcdd-4678-9cbc-5264fb6830d4"
      }
    }
  }
}
