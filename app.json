{
  "expo": {
    "name": "ConvoSquad",
    "slug": "convosquad",
    "version": "0.1.0",
    "scheme": "convosquad",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.convosquad.app"
    },
    "android": {
      "package": "com.convosquad.app"
    },
    "web": { "output": "static" },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": { "typedRoutes": true }
  }
}
