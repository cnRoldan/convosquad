{
  "expo": {
    "name": "ConvoSquad",
    "slug": "k1mbowx",
    "version": "0.1.0",
    "scheme": "convosquad",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.convosquad.app"
    },
    "android": {
      "package": "com.convosquad.app",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0B1210"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "call-ups",
          "color": "#B4F16C",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que ConvoSquad seleccione una imagen para el escudo de tu club.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "99946f80-dcdd-4678-9cbc-5264fb6830d4"
      }
    },
    "owner": "convosquad",
    "icon": "./assets/images/icon.png"
  }
}
