{
  "name": "convosquad",
  "main": "index.ts",
  "version": "0.1.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.62.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint",
    "export": "expo export",
    "export:web": "expo export --platform web",
    "eas": "npx eas-cli@24.13.0",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "db:types": "node scripts/generate-database-types.mjs",
    "db:types:check": "node scripts/generate-database-types.mjs --check",
    "test": "npm run test:unit && npm run test:db",
    "test:unit": "node --test tests/*.test.mjs",
    "supabase:check": "node scripts/check-supabase.mjs",
    "supabase": "npm run supabase:check",
    "auth:check": "node scripts/check-ea-auth.mjs",
    "test:ui": "node scripts/test-call-up-ui.mjs",
    "eas:preflight": "node scripts/check-eas-build.mjs",
    "check:push-server": "DENO_TLS_CA_STORE=system npx --yes deno@2.5.6 check --config supabase/functions/deno.json supabase/functions/prepare-push/index.ts supabase/functions/send-reminders/index.ts supabase/functions/send-reminders/dashboard.ts"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0"
  }
}
